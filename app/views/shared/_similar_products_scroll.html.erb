<% if similar_products.any? %>
  <div class="similar-products">
    <h4>Similar Products</h4>
    <div class="similar-wrapper" data-controller="scroll">
      <button
        class="scroll-btn scroll-btn--left"
        type="button"
        aria-label="Scroll left"
        data-action="click->scroll#scrollLeft">
        ‹
      </button>

      <div class="similar-scroll" data-scroll-target="container">
        <% similar_products.each do |similar_product| %>
          <div class="similar-scroll__item">
            <%= render "shared/match_card",
              product: similar_product,
              brand: similar_product.brand,
              product_path: local_assigns[:product_path_helper] ? send(product_path_helper, similar_product) : explore_path(similar_product),
              search: local_assigns[:search] %>
          </div>
        <% end %>
      </div>

      <button
        class="scroll-btn scroll-btn--right"
        type="button"
        aria-label="Scroll right"
        data-action="click->scroll#scrollRight">
        ›
      </button>
    </div>
  </div>
<% end %>
