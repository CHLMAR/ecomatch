<div class="rating-wrapper">
  <div class="general-rating">
    <div class="general-rating__score">



        <div class="rating-comparison">
          <h1><%= brand.overall_rating %></h1>
          <div class="rating-label">
            <p>Sustainability</p><p>score</p>
          </div>
        </div>

        <div class="rating-cat__item">
          <% brand.overall_rating.times do %>
            <i class="fa-solid fa-leaf rating-icon rating-icon--green"></i>
          <% end %>
          <% (5 - brand.overall_rating).times do %>
            <i class="fa-solid fa-leaf rating-icon rating-icon--gray"></i>
          <% end %>
        </div>

    </div>
  </div>

  <div class="other-ratings flex-column">
    <div class="rating-cat">
      <p class="rating-cat__title">People</p>
      <div class="rating-cat__item">
        <% brand.people_rating.times do %>
          <i class="fa-solid fa-child rating-icon rating-icon--green"></i>
        <% end %>
        <% (5 - brand.people_rating).times do %>
          <i class="fa-solid fa-child rating-icon rating-icon--gray"></i>
        <% end %>
      </div>
    </div>
    <hr>
    <div class="rating-cat">
      <p class="rating-cat__title">Animals</p>
      <div class="rating-cat__item">
        <% brand.animals_rating.times do %>
          <i class="fa-solid fa-paw rating-icon rating-icon--green"></i>
        <% end %>
        <% (5 - brand.animals_rating).times do %>
          <i class="fa-solid fa-paw rating-icon rating-icon--gray""></i>
        <% end %>
      </div>
    </div>
    <hr>
    <div class="rating-cat">
      <p class="rating-cat__title">Planet</p>
      <div class="rating-cat__item">
        <% brand.planet_rating.times do %>
          <i class="fa-solid fa-earth-americas rating-icon rating-icon--green"></i>
        <% end %>
        <% (5 - brand.planet_rating).times do %>
          <i class="fa-solid fa-earth-americas rating-icon rating-icon--gray"></i>
        <% end %>
      </div>
    </div>
  </div>
</div>
