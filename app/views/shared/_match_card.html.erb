
<%= link_to search_match_path(search, match), class: "card-link" do %>
  <div class="card-match">

    <%= image_tag(
          product.item_image.presence || "sweater.jpg",  # replace with placehoder image when there is no available image
          alt: product.clothing_item
        ) %>

    <div class="card-match-infos">
        <div class="brand">
          <p class="brand-name"><%= brand.name %> </p>

          <div class="rating">
            <p class="rating-score"><%= brand.overall_rating %></p>
            <i class="fa-solid fa-star"></i>
          </div>
        </div>

        <h2><%= product.clothing_item %></h2>

        <p class="card-match-pricing">
          <%= product.clothing_price %>
        </p>
    </div>

  </div>
<% end %>
