<% link_url = if local_assigns[:product_path].present?
                local_assigns[:product_path]
              elsif local_assigns[:search].present?
                search_product_path(search, product)
              else
                product.external_link
              end %>
<% link_options = { class: "card-link" }
   link_options[:target] = "_blank" unless local_assigns[:product_path].present? || local_assigns[:search].present?
   link_options[:data] = { turbo_frame: "_top" } if local_assigns[:search].present? %>
<%= link_to link_url, **link_options do %>
  <div class="card-match">

    <div class="card-image">
    <%= image_tag(
          product.item_image.presence || "placeholder_outfit.png",
          alt: product.clothing_item,
          class: "card-img"
        ) %>

    <div class="card-price">
        € <%= product.clothing_price %>
      </div>
    </div>

    <div class="card-match-infos">

      <div class="card-brand-info">
        <p class="brand-name"><%= brand.name %> </p>
        <div class="rating">

          <% brand.overall_rating.times do %>
            <i class="fa-solid fa-leaf leaf-sm" style="color: #5ce242"></i>
          <% end %>
          <% (5 - brand.overall_rating).times do %>
            <i class="fa-solid fa-leaf leaf-sm" style="color: #c8c8c8"></i>
          <% end %>
        </div>
      </div>

        <div class="brand">
          <h2><%= product.clothing_colour %> <%= product.clothing_item %></h2>
        </div>

    </div>

    <% if user_signed_in? %>
      <%= render "shared/wishlist_button", product: product %>
    <% end %>
  </div>
<% end %>
