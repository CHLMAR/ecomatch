<% link_url = if local_assigns[:product_path].present?
                local_assigns[:product_path]
              elsif local_assigns[:search].present?
                search_product_path(search, product)
              else
                product.external_link
              end %>
<% link_options = { class: "card-link" }
   link_options[:target] = "_blank" unless local_assigns[:product_path].present? || local_assigns[:search].present?
   link_options[:data] = { turbo_frame: "_top" } if local_assigns[:search].present? || local_assigns[:product_path].present? %>
<%= link_to link_url, **link_options do %>
  <div class="card-match">

    <div class="card-image">
    <%= image_tag(
          product.item_image.presence || "placeholder_outfit.png",
          alt: product.clothing_item,
          class: "card-img"
        ) %>
      <% if brand.overall_rating == 5 %>
        <div class="card-badge">
          <i class="fa-solid fa-fire"></i> TOP RATING
        </div>
      <% end %>
    </div>

    <div class="card-match-infos">
      <div class="card-brand-info truncate">
        <p class="brand-name"><%= brand.name %> </p>
      </div>

      <div class="product-name">
        <h2 class="product-name_full truncate"><%= product.clothing_colour %> <%= product.clothing_item %></h2>
      </div>

      <div class="card-match-infos__bottom">
        <div class="rating">
          <% brand.overall_rating.times do %>
            <i class="fa-solid fa-leaf leaf rating-icon--green"></i>
          <% end %>
          <% (5 - brand.overall_rating).times do %>
            <i class="fa-solid fa-leaf leaf rating-icon--gray"></i>
          <% end %>
        </div>
        <div class="card-price">
          <p>€ <%= product.clothing_price %></p>
        </div>
      </div>

    </div>

    <% if user_signed_in? %>
      <%= render "shared/wishlist_button", product: product %>
    <% end %>
  </div>
<% end %>
