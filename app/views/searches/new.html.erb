<div data-controller="form-loader"> <!-- the JS element in the javascripti folder -->
  <!-- Full page loading overlay with animated text -->
  <div data-form-loader-target="overlay" class="loader-overlay">
    <span class="loader">Entering the realm of sustainable fashion...</span>
  </div>

  <h1>New Search</h1>

  <div class="container-fluid w-50">
    <%= simple_form_for @search, url: searches_path, method: :post, html: { multipart: true, class: "mt-4", data: { form_loader_target: "form" } } do |f| %>
      <div class="mb-3">
        <%= f.input :uploaded_image, as: :file, label: "Upload an image",
            input_html: { class: "form-control", accept: "image/*" } %>
      </div>

      <div class="d-flex align-items-center my-3">
        <hr class="flex-grow-1">
        <span class="mx-3 text-muted">OR</span>
        <hr class="flex-grow-1">
      </div>

      <div class="mb-3">
        <%= f.input :uploaded_link, label: "Paste a website link",
            input_html: { class: "form-control", placeholder: "https://example.com/product" } %>
      </div>

      <%= f.submit "Search", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<%#= !!!!!!!!!!!!TEST!!!!!!!!!!!!!%>
<h2>TEST System Prompt:</h2>
<p>><%= @search.system_prompt %></p>

<h2>TEST LLM raw response</h2>
<p>><%= @raw_response %></p>

<h2>TEST Parsed Values</h2>
<ul>
  <li><strong>clothing_item:</strong> <%= @search.clothing_item %></li>
  <li><strong>clothing_material:</strong> <%= @search.clothing_material %></li>
  <li><strong>clothing_colour:</strong> <%= @search.clothing_colour %></li>
  <li><strong>clothing_brand:</strong> <%= @search.clothing_brand %></li>
  <li><strong>clothing_price:</strong> <%= @search.clothing_price %></li>
  <li><strong>item_name:</strong> <%= @search.item_name %></li>
  <li><strong>item_description:</strong> <%= @search.item_description %></li>
  <li><strong>item_image:</strong> <%= @search.item_image %></li>
</ul>
