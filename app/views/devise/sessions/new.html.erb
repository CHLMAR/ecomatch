<div class="auth-page">
  <div class="auth-container">
    <h2 class="auth-title">Log in</h2>
    <p class="auth-subtitle">Welcome back to Ecomatch</p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email", class: "auth-input" },
                    label: "Email" %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "current-password", class: "auth-input" },
                    label: "Password" %>
        <%= f.input :remember_me, as: :boolean, wrapper_html: { class: "auth-remember" } if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in", class: "eco-btn eco-btn--primary" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
