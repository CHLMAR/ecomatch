<div class="container-fluid">
  <div class="row">
    <%# Sidebar %>
    <div class="col-12 col-lg-3 uploaded-product-sidebar">
        <%= render "shared/new_search" %>
        </div>

    <%# Filters and results %>
    <div class="col-12 col-lg-9 matches-section">

      <div class="results-section">
        <h2>Explore Our Sustainable Collection</h2>
        <p class="text-muted mb-4">Browse <%= @comparison_products.count %> eco-friendly products</p>

        <%= turbo_frame_tag "results_frame", data: { turbo_action: "advance" } do %>
          <div class="results-section__filters">
            <%= render "shared/product_filters",
                form_url: explore_path,
                clear_url: explore_path  %>
          </div>
        <% end %>

        <div class="matches-list">
          <% @comparison_products.each do |product| %>
            <% brand = product.brand %>
            <div class="match-item">
              <%= render "shared/match_card",
                    product: product,
                    brand: brand,
                    product_path: explore_product_path(product) %>
            </div>
          <% end %>
        </div>
      </div>

    </div>

  </div>
</div>
