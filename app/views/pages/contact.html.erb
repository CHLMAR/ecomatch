<div class="page-contact">
  <section class="page-contact__hero">
    <div class="container">
      <h1 class="page-contact__hero-title">Get in touch</h1>
      <p class="page-contact__hero-subline">We'd love to hear from you.</p>
    </div>
  </section>

  <section class="page-contact__content">
    <div class="container">
      <div class="page-contact__card">
        <div class="page-contact__card-icon">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        </div>
        <h2 class="page-contact__card-title">Have feedback, questions, or suggestions?</h2>
        <p class="page-contact__card-text">Send us an email and we'll get back to you as soon as we can.</p>
        <%= link_to "hello@ecomatch.info", "mailto:hello@ecomatch.info", class: "page-contact__email btn btn-primary btn-lg rounded-pill px-4" %>
      </div>
    </div>
  </section>
</div>
