<div class="row">
    <%# Sidebar %>
    <div class="col-lg-3 col-md-4 uploaded-product-sidebar">
      <div class="tabs-header">
        <ul class="nav brand-tabs__nav" role="tablist">
          <li class="nav-item" role="presentation">
            <button
              class="nav-link active"
              data-bs-toggle="tab"
              data-bs-target="#brand-score"
              type="button"
              role="tab"
              aria-selected="true">
              Your item
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              data-bs-toggle="tab"
              data-bs-target="#about-brand"
              type="button"
              role="tab"
              aria-selected="false">
              New search
            </button>
          </li>
        </ul>
      </div>

      <div class="tab-content brand-tabs__content mt-3">
        <div class="tab-pane fade show active uploaded-product-partial" id="brand-score" role="tabpanel">
          <%= render "shared/uploaded_product" %>
        </div>

        <div class="tab-pane fade new-search-partial" id="about-brand" role="tabpanel">
          <%= render "shared/new_search" %>
        </div>
      </div>
    </div>


















































    <%# Filters and results %>
    <div class="col-lg-9 col-md-8 matches-section">

        <div class="results-section">
          <h2>You've got <%= @comparison_products.count %> matches</h2>

          <%= turbo_frame_tag "results_frame", data: { turbo_action: "advance" } do %>
            <div class="results-section__filters">
              <%= render "shared/product_filters",
                  form_url: search_matches_path(@search),
                  search: @search,
                  clear_url: search_matches_path(@search, clear: true) %>
            </div>
          <% end %>

            <div class="matches-list">
              <% @comparison_products.each do |product| %>
                <% brand = product.brand %>
                <div class="match-item">
                  <%= render "shared/match_card",
                        search: @search,
                        product: product,
                        brand: brand %>
                </div>
              <% end %>
            </div>

        </div>
    </div>
  </div>
