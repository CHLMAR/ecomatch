<div class="container">
  <div class="row">
    <div class="col-lg-3 col-md-4 uploaded-product-sidebar">

      <div class="uploaded-product">

        <%= image_tag(
              "placeholder_outfit.png",
              alt: "image of a sweater"
            ) %>

        <div class="uploaded-product-info">
          <p>Jeans</p>
          <p>Forever 21</p>
        </div>

      </div>













    </div>

    <div class="col-lg-9 col-md-8 results-section">
      <h2>You've got <%= @matches.count %> matches</h2>
      <div class="filters">

        <div class="dropdown">
          Colour:
          <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            Select
          </button>
          <ul class="dropdown-menu dropdown-menu-dark">
            <li><a class="dropdown-item active" href="#">All</a></li>
            <% @matches.each do |match| %>
              <li><a class="dropdown-item active" href="#"> <%= match.comparison_product.clothing_colour %></a></li>
            <% end%>
          </ul>
        </div>

        <div class="dropdown">
          Material:
          <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            Select
          </button>
          <ul class="dropdown-menu dropdown-menu-dark">
            <li><a class="dropdown-item active" href="#">All</a></li>
            <% @matches.each do |match| %>
              <li><a class="dropdown-item active" href="#"> <%= match.comparison_product.clothing_material %></a></li>
            <% end%>
          </ul>
        </div>

        <div class="dropdown">
          Clothing item:
          <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            Select
          </button>
          <ul class="dropdown-menu dropdown-menu-dark">
            <li><a class="dropdown-item active" href="#">All</a></li>
            <% @matches.each do |match| %>
              <li><a class="dropdown-item active" href="#"> <%= match.comparison_product.clothing_item %></a></li>
            <% end%>
          </ul>
        </div>
      </div>


      <div class="matches-list">
        <% @matches.each do |match| %>
          <% product = match.comparison_product %>
          <% brand = product.brand %>

          <div class="match-item">
            <%= render "shared/match_card",
                  search: @search,
                  match: match,
                  product: product,
                  brand: brand %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>
