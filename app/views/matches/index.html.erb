<div class="container">
  <div class="row">
    <div class="col-lg-3 col-md-4 uploaded-product-sidebar">

      <div class="uploaded-product">

        <%= image_tag(
              @search.item_image.presence || "placeholder_outfit.png",
              alt: "image of a sweater"
            ) %>

        <div class="uploaded-product-info">
          <p>Jeans</p>
          <p>Forever 21</p>
        </div>

      </div>
    </div>
    <div class="col-lg-9 col-md-8 matches-section">
  <h2>You've got <%= @comparison_products.count %> matches</h2>

  <%= form_with url: search_matches_path(@search), method: :get, local: true, class: "filters mb-4" do %>
    <div class="row g-3">
      <div class="col-md-3">
        <%= label_tag :clothing_item, "Clothing Item", class: "form-label" %>
        <%= text_field_tag :clothing_item, params[:clothing_item] || @search.clothing_item.capitalize, class: "form-control", placeholder: "e.g. T-shirt, Jacket" %>
      </div>
      <div class="col-md-3">
        <%= label_tag :clothing_colour, "Colour", class: "form-label" %>
        <%= text_field_tag :clothing_colour, params[:clothing_colour] || @search.clothing_colour.capitalize, class: "form-control", placeholder: "e.g. Blue, Red" %>
      </div>
      <div class="col-md-3">
        <%= label_tag :clothing_material, "Material", class: "form-label" %>
        <%= text_field_tag :clothing_material, params[:clothing_material], class: "form-control", placeholder: "e.g. Cotton, Wool" %>
      </div>
      <div class="col-md-3">
        <%= label_tag :overall_rating, "Min Rating", class: "form-label" %>
        <%= select_tag :overall_rating, options_for_select([["Any", ""], ["1+", 1..5], ["2+", 2..5], ["3+", 3..5], ["4+", 4..5 ], ["5", 5]], params[:overall_rating]), class: "form-select" %>
      </div>
    </div>
    </div>
  <% end %>

  <div class="matches-list">
    <% @comparison_products.each do |product| %>
      <% brand = product.brand %>
      <div class="match-item">
        <%= render "shared/match_card",
              search: @search,
              product: product,
              brand: brand %>
      </div>
      <% end %>


  </div>
</div>
</div>
</div>
