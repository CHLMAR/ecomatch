<% product = @comparison_product %>
<% brand = product.brand %>
<div class="container">
  <%= link_to request.referer || root_path do %>
    <div class="link-back"><i class="fa-solid fa-arrow-left"></i> Back</div>
  <% end %>

  <div class="row card-product-lg g-0 align-items-stretch">
    <div class="col-4">
      <%= image_tag(
        product.item_image.presence || "placeholder_outfit.png",
        class: "img-fluid w-100 h-100 object-fit-cover",
        alt: product.clothing_item
      ) %>
    </div>

    <div class="col-8 product-card-show product-card-show--with-wishlist">
      <% if user_signed_in? %>
        <div class="wishlist-button wishlist-button--main-card">
          <% if saved_to_wishlist?(product) %>
            <%= button_to remove_from_wishlist_comparison_product_path(product), method: :delete, class: "btn-wishlist saved", title: "Remove from wishlist" do %>
              <i class="fa-solid fa-heart"></i>
            <% end %>
          <% else %>
            <%= button_to add_to_wishlist_comparison_product_path(product), method: :post, class: "btn-wishlist", title: "Save to wishlist" do %>
              <i class="fa-regular fa-heart"></i>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <h2><%= product.clothing_item %></h2>
      <p class="product-description">
        <%= product.product_description %>
      </p>

      <p class="product-price-lg"><%= product.clothing_price %></p>
      <%= link_to product.external_link, class: "btn-2", target: "_blank" do %>
        View details
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      <% end %>

      <div class="brand-intro">
        <div class="overall-rating">
          <h5><%= brand.name %></h5>
          <p class="brand-description-full">
            <%= brand.description %>
          </p>
        </div>

        <div class="overall-rating-container">
          <div class="score">
            <div class="rating-vs">
                <div class="rating-item overall-brand-rating">
                  <h5>Sustainability score</h5>
                  <div class="rating-item">
                    <div class="rating-item__label">Overall</div>
                        <% brand.overall_rating.times do %>
                          <i class="fa-solid fa-leaf leaf rating-icon--green"></i>
                        <% end %>
                        <% (5 - brand.overall_rating).times do %>
                          <i class="fa-solid fa-leaf leaf rating-icon--gray"></i>
                        <% end %>
                  </div>
                </div>
              <h2><%= brand.overall_rating %></h2>
              <p class="total-rating"> / 5</p>
            </div>
          </div>
        </div>
      </div>

      <div class="secondary-ratings">
        <div class="rating-category">
          <p class="rating-title">People</p>
          <div class="rating-item">
            <% brand.people_rating.times do %>
              <i class="fa-solid fa-child rating-icon rating-icon--green"></i>
            <% end %>
            <% (5 - brand.people_rating).times do %>
              <i class="fa-solid fa-child rating-icon rating-icon--gray"></i>
            <% end %>
          </div>
        </div>
        <div class="rating-category">
          <p class="rating-title">Animals</p>
          <div class="rating-item">
            <% brand.animals_rating.times do %>
              <i class="fa-solid fa-paw rating-icon rating-icon--green"></i>
            <% end %>
            <% (5 - brand.animals_rating).times do %>
              <i class="fa-solid fa-paw rating-icon rating-icon--gray"></i>
            <% end %>
          </div>
        </div>
        <div class="rating-category">
          <p class="rating-title">Planet</p>
          <div class="rating-item">
            <% brand.planet_rating.times do %>
              <i class="fa-solid fa-earth-americas rating-icon rating-icon--green"></i>
            <% end %>
            <% (5 - brand.planet_rating).times do %>
              <i class="fa-solid fa-earth-americas rating-icon rating-icon--gray"></i>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if @similar_products.any? %>
    <div class="similar-products">
      <h3>Similar Products</h3>

      <div class="similar-products-list">
        <% @similar_products.each do |similar_product| %>
          <div class="similar-product-item">
            <%= render "shared/match_card",
                  search: @search,
                  product: similar_product,
                  brand: similar_product.brand %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
