<div class="container">
  <h1>Product details</h1>
  <div class="row">
    <% product = @match.comparison_product %>
    <% brand = product.brand %>
    <%= image_tag(
          product.item_image.presence || "sweater.jpg",  # replace with placehoder image when there is no available image
          alt: product.clothing_item,
          class: "col-sm"
        ) %>
    <div class="col-sm">
      <h3><%= product.clothing_item %></h3>
      <div class="rating-category">
        <p>Planet</p>
        <div class="rating-item">
          <p class="rating-score-lg"><%= brand.planet_rating %></p>
          <i class="fa-solid fa-star"></i>
        </div>
      </div>
      <div class="rating-category">
        <p>People</p>
        <div class="rating-item">
          <p class="rating-score-lg"><%= brand.people_rating %></p>
          <i class="fa-solid fa-star"></i>
        </div>
      </div>
      <div class="rating-category">
        <p>Animals</p>
        <div class="rating-item">
          <p class="rating-score-lg"><%= brand.animals_rating %></p>
          <i class="fa-solid fa-star"></i>
        </div>
      </div>

      <p class="product-description">
        <%= product.product_description %>
      </p>
      <p class="product-price-lg"><%= product.clothing_price %></p>
      <%= link_to "View more", product.external_link, class: "btn-2", target: "_blank" %>
    </div>
  </div>


  <div class="similar-products">
    <h3>Similar Products</h3>

    <div class="similar-products-list">
      <% @matches.each do |match| %>
        <div class="similar-product-item">
          <%= render "shared/match_card",
                search: @search,
                match: match,
                product: product,
                brand: brand %>
        </div>
      <% end %>
    </div>
  </div>
</div>
