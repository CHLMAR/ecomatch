<div class="container">
  <h1>My Wishlist</h1>
  
  <% if @wishlist_items.any? %>
    <div class="row">
      <% @wishlist_items.each do |wishlist_item| %>
        <% product = wishlist_item.comparison_product %>
        <% brand = product.brand %>
        <div class="col-md-3 col-sm-6 mb-4">
          <%= render 'shared/match_card', product: product, brand: brand %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>Your wishlist is empty.</p>
  <% end %>
</div>
